# Jira Cloud
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# MSSQL
MSSQL_SERVER=your-sql-server.database.windows.net
MSSQL_DATABASE=your-database
MSSQL_USER=your-user
MSSQL_PASSWORD=

# Optional: set to "yes" for local/dev SQL Server instances with self-signed certs
MSSQL_TRUST_SERVER_CERTIFICATE=no
